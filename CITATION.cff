    family-names: Raparla
    alias: pranava0x0
type: dataset
license: CC0-1.0
repository-code: "https://github.com/pranava0x0/vibe-coding-security"
url: "https://pranava0x0.github.io/vibe-coding-security/"
keywords:
  - supply-chain-security
  - npm
  - pypi
  - mcp
  - prompt-injection
  - ai-coding-tools
  - vibe-coding
  - cursor
  - claude-code
  - llm-security
date-released: 2026-05-16
